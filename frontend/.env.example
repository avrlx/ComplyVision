NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public credentials: never put a service-role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after completing docs/AUTH_DATABASE_SETUP.md.
# Defaults preserve the existing session workspace and local exports.
COMPLYVISION_AUTH_ENABLED=false
COMPLYVISION_DATABASE_ENABLED=false
COMPLYVISION_APP_ENV=development

# Keep phone sign-in disabled even if the provider is enabled later.
COMPLYVISION_PHONE_AUTH_ENABLED=false

# Testing deployment only. Never use production values here.
# SUPABASE_SERVICE_ROLE_KEY is server-only despite living in the frontend service.
SUPABASE_SERVICE_ROLE_KEY=
COMPLYVISION_TEST_USER_ID=
